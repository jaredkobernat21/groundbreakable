NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-only -- powers the "Ask about {Market}" AI search bar (src/app/api/ask/route.ts).
# Get a key at https://console.anthropic.com/. Without it, the search bar returns a clear error.
ANTHROPIC_API_KEY=
# Server-only, never expose to the client -- bypasses RLS. Powers the
# no-login tester link at /preview/topeka (src/lib/supabase/admin.ts).
# Get it from Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=
